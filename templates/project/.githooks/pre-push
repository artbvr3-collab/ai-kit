#!/bin/sh
# Blocks pushing code changes without a SOUL.md update.
# If the change doesn't affect the project's meaning (typo, small fix):
#   SKIP_SOUL=1 git push

[ "$SKIP_SOUL" = "1" ] && exit 0
[ -f SOUL.md ] || exit 0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Branch deletion: nothing to check.
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac

  case "$remote_sha" in
    *[!0]*) range="$remote_sha..$local_sha" ;;
    *)      range="$local_sha --not --remotes" ;;  # new branch
  esac

  # shellcheck disable=SC2086
  changed=$(git log --format= --name-only $range | sort -u | grep -v '^$')
  [ -z "$changed" ] && continue

  if echo "$changed" | grep -qx 'SOUL.md'; then
    continue
  fi
  if echo "$changed" | grep -qvE '^(notes/|README|\.gitignore$)'; then
    echo "pre-push: this push changes code but SOUL.md was not updated ($remote_ref)." >&2
    echo "  Update SOUL.md (features, decisions, status) and commit it." >&2
    echo "  If the change doesn't affect the project's meaning: SKIP_SOUL=1 git push" >&2
    exit 1
  fi
done

exit 0
